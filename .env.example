# Local development only. Never use these example values in production.
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_RESOURCE_URL=http://127.0.0.1:8000/mcp

# Local static bearer tokens are DEVELOPMENT ONLY.
# Replace this sample with a long random token before running locally.
DEV_BEARER_TOKENS_JSON='{"replace-with-a-long-random-local-token":{"sub":"local-developer","scopes":["analyzer:invoke","analyzer:read"]}}'

# Production uses an external OAuth 2.1 / OIDC issuer.
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=http://127.0.0.1:8000/mcp
OIDC_ALLOWED_ALGORITHMS=RS256

# OpenAI-compatible Chat Completions provider.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_OUTPUT_TOKENS=2500

# Memory limiter is for local development only.
RATE_LIMIT_BACKEND=memory
REDIS_URL=
RATE_LIMIT_PER_MINUTE=20

# Replace with a random secret. Used only to pseudonymize actor IDs in logs.
AUDIT_HASH_SALT=replace-this-local-audit-salt
MCP_ALLOWED_HOSTS=127.0.0.1:8000,127.0.0.1:*,localhost:8000,localhost:*
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:6274,http://127.0.0.1:6274
LOG_LEVEL=INFO
