{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-analyzer.local/schemas/v0.9.0/residual-unknowns.schema.json",
  "title": "SKILL ANALYZER Residual Unknown Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unknown_id",
    "question",
    "materiality",
    "known",
    "unknown",
    "required_evidence",
    "status",
    "impact_if_unresolved"
  ],
  "properties": {
    "unknown_id": {
      "type": "string",
      "pattern": "^UNK-[A-Z0-9-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 5
    },
    "category": {
      "enum": [
        "evidence",
        "scope",
        "causality",
        "technical",
        "temporal",
        "governance",
        "measurement",
        "other"
      ]
    },
    "materiality": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "known": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "INVESTIGATING",
        "EVIDENCE_PENDING",
        "RESOLVED",
        "ACCEPTED_LIMITATION",
        "CLOSED"
      ]
    },
    "impact_if_unresolved": {
      "type": "string"
    },
    "resolution_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_authority": {
      "type": [
        "string",
        "null"
      ]
    },
    "accepted_rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_trigger": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_failure_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "occurrence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opened_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "review_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewed_at",
          "status"
        ],
        "properties": {
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": [
              "OPEN",
              "INVESTIGATING",
              "EVIDENCE_PENDING",
              "RESOLVED",
              "ACCEPTED_LIMITATION",
              "CLOSED"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESOLVED"
          }
        }
      },
      "then": {
        "properties": {
          "resolution_evidence": {
            "minItems": 1
          }
        },
        "required": [
          "resolution_evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ACCEPTED_LIMITATION"
          }
        }
      },
      "then": {
        "required": [
          "acceptance_authority",
          "accepted_rationale",
          "review_trigger"
        ]
      }
    }
  ]
}
