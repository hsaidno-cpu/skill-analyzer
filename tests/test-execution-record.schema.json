{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill-analyzer.local/schemas/v0.9.0/test-execution-record.schema.json",
  "title": "SKILL ANALYZER Test Execution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "case_id",
    "plugin_version",
    "test_layer",
    "status",
    "observed_at",
    "observed_behavior",
    "evidence_refs"
  ],
  "properties": {
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 3
    },
    "case_id": {
      "type": "string",
      "pattern": "^(R|E|G|F|C|D|X|I|T)[0-9]{2}$"
    },
    "plugin_version": {
      "type": "string"
    },
    "release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_layer": {
      "enum": [
        "STATIC",
        "CONTRACT",
        "HARNESS",
        "HOST_BEHAVIOR",
        "RUNTIME_TRACE",
        "PACKAGE",
        "MUTATION",
        "SCHEMA"
      ]
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "BLOCKED",
        "STATIC_CHECK_PASSED",
        "CONTRACT_TEST_PASSED",
        "HOST_BEHAVIOR_PASSED",
        "RUNTIME_TRACE_PASSED",
        "FAILED",
        "WAIVED_WITH_RATIONALE"
      ]
    },
    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "observed_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "NONE"
      ]
    },
    "defect_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waiver": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "authority",
        "rationale",
        "review_trigger"
      ],
      "properties": {
        "authority": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "review_trigger": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "STATIC_CHECK_PASSED",
              "CONTRACT_TEST_PASSED",
              "HOST_BEHAVIOR_PASSED",
              "RUNTIME_TRACE_PASSED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "string"
          },
          "observed_behavior": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "minItems": 1
          },
          "run_id": {
            "type": "string",
            "minLength": 3
          }
        },
        "required": [
          "run_id"
        ]
      },
      "required": [
        "observed_at",
        "observed_behavior",
        "evidence_refs"
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAIVED_WITH_RATIONALE"
          }
        }
      },
      "then": {
        "required": [
          "waiver"
        ]
      }
    }
  ]
}
